# Use python scripts/configure.py to generate fresh secrets in an ignored .env.
POSTGRES_PASSWORD=replace-with-a-random-secret
SETUP_TOKEN=replace-with-a-random-setup-token
SITE_ADDRESS=tone.example.edu.cn
CADDY_CONFIG_FILE=./Caddyfile
# Optional additional domain when selecting ./Caddyfile.dual with a public IP.
DOMAIN_ADDRESS=
AUDIO_RETENTION_DAYS=30
CELERY_CONCURRENCY=2
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_REASONING_EFFORT=high
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
